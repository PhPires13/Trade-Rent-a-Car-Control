# Copie para .env e ajuste. Em produção (Railway), defina como variáveis do serviço.
# SECRET_KEY é OBRIGATÓRIA em produção (DEBUG=False) — o app não sobe sem ela.
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=troque-por-uma-chave-secreta-forte
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Chave da criptografia das credenciais dos portais de multas (opcional; default = SECRET_KEY).
# Defina uma própria ANTES de cadastrar credenciais — assim dá para rotacionar a SECRET_KEY
# sem perder as senhas gravadas. Depois de definida, não pode mais ser trocada sem recadastro.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
# CREDENCIAIS_KEY=
# Produção: postgres://usuario:senha@host:5432/banco (Neon/Railway)
# Local: deixe vazio para usar SQLite
# DATABASE_URL=
# CSRF_TRUSTED_ORIGINS=https://seudominio.up.railway.app
# Leitura automática da CNH no cadastro de motorista (opcional — sem a chave, o
# cadastro funciona normalmente, só sem o preenchimento automático).
# ANTHROPIC_API_KEY=
# Chave Pix da empresa — aparece na mensagem de cobrança pronta do WhatsApp.
# CHAVE_PIX=
# Produção: volume persistente para fotos/documentos (Railway: monte um volume em /data)
# MEDIA_ROOT=/data/midia
# Dados da empresa impressos no contrato de locação — PREENCHA no deploy:
# sem eles o contrato sai com CNPJ e endereço da locadora em branco.
# EMPRESA_RAZAO_SOCIAL=Trade Rent a Car LTDA
# EMPRESA_CNPJ=00.000.000/0001-00
# EMPRESA_ENDERECO=Rua X, 123 — Bairro — Belo Horizonte/MG
# EMPRESA_CIDADE_UF=Belo Horizonte/MG

# ---------------------------------------------------------------------------
# Produção (Railway) — copie este bloco para as variáveis do serviço, trocando
# "seuapp" pelo endereço que o Railway der:
# DEBUG=False
# ALLOWED_HOSTS=seuapp.up.railway.app
# CSRF_TRUSTED_ORIGINS=https://seuapp.up.railway.app
# DATABASE_URL=postgres://usuario:senha@ep-xxx-pooler.sa-east-1.aws.neon.tech/banco?sslmode=require
# MEDIA_ROOT=/data/midia
# Opcionais (já vêm com o valor certo; só mude se souber o motivo):
# PROXIES_CONFIAVEIS=1   (proxies na frente do app: 1 no Railway, 0 rodando local)
# CONN_MAX_AGE=60        (segundos que a conexão com o banco é reaproveitada)
# CNH_MODELO=claude-opus-5   (modelo da leitura automática da CNH)
#
# A sonda de saúde do Railway (healthcheck.railway.app, caminho /saude/) já é
# aceita sozinha com DEBUG=False — não precisa pôr esse host no ALLOWED_HOSTS.
#
# Serviços no Railway (mesmo repositório, mesmas variáveis):
# 1. web  — usa o Procfile e o railway.json (sonda de saúde em /saude/).
# 2. rotina diária — crie um 2º serviço e, em Settings > Config-as-code, aponte
#    para "railway.cron.json" (roda "python manage.py rotina_diaria" às 03:05 UTC =
#    00:05 de Brasília e termina). Sem isso ele sobe o site de novo, nunca termina
#    e a rotina (aluguel da semana, atrasos) não roda.
# Primeiro acesso, depois do 1º deploy: railway run python manage.py createsuperuser
